# =====================================================================
# Ambiente LOCAL (Supabase CLI / Docker) — copie para `.env.local`
#
#   cp .env.example .env.local && npm run dev
#
# Vite carrega `.env.local` com prioridade sobre `.env`, então o app
# aponta para o Supabase local sem risco de tocar em produção.
# `.env.local` já está no .gitignore.
# =====================================================================

VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PROJECT_ID="local"

# anon key padrão e pública do stack local do Supabase CLI (igual em toda máquina)
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjQxNzY5MjAwLCJleHAiOjE3OTk1MzU2MDB9.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE"

# Marca a sessão como offline para os guards de integração no frontend.
VITE_LOCAL_MODE="true"

# ---------------------------------------------------------------------
# Secrets das Edge Functions locais → coloque em `supabase/.env.local`
# e rode `supabase functions serve --env-file supabase/.env.local`.
# Deixe em branco para usar os mocks offline (nada sai da máquina).
# ---------------------------------------------------------------------
# LOCAL_MODE=true
# RESEND_API_KEY=
# GOOGLE_SEARCH_CONSOLE_API_KEY=
# LOVABLE_API_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
